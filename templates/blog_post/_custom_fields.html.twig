{% macro custom_field_row(rowForm) %}
    <div class="custom-fields__item" data-collection-target="item">
        {{ form_row(rowForm.key) }}
        {{ form_row(rowForm.value) }}
        <button class="close" type="button" data-action="collection#remove">{{ 'blogpost.form.custom_fields.remove'|trans }}</button>
    </div>
{% endmacro %}

<div class="custom-fields"
     data-controller="collection"
     data-collection-index-value="{{ form.customFields|length }}"
     data-collection-prototype-value="{{ _self.custom_field_row(form.customFields.vars.prototype)|e('html_attr') }}"
>
    <label>{{ 'blogpost.form.custom_fields.label'|trans }}</label>

    <div data-collection-target="list">
        {% for customField in form.customFields %}
            {{ _self.custom_field_row(customField) }}
        {% endfor %}
    </div>

    <button type="button" data-action="collection#add">{{ 'blogpost.form.custom_fields.add'|trans }}</button>
</div>
