{% macro image_row(rowForm) %}
    <div class="images-picker__item default-input"
         data-images-picker-target="item"
         draggable="true"
         data-action="dragstart->images-picker#dragStart dragover->images-picker#dragOver drop->images-picker#drop dragend->images-picker#dragEnd"
    >
        <span class="images-picker__handle">::</span>
        <span class="images-picker__label"data-images-picker-target="itemLabel">{{ rowForm.vars.imageUrl|default('') }}</span>
        {{ form_widget(rowForm, {attr: {hidden: true}}) }}
        <button type="button" data-action="images-picker#remove">{{ 'blogpost.form.custom_fields.remove'|trans }}</button>
    </div>
{% endmacro %}

<div class="images-picker"
     data-controller="images-picker"
     data-images-picker-index-value="{{ form.images|length }}"
     data-images-picker-prototype-value="{{ _self.image_row(form.images.vars.prototype)|e('html_attr') }}"
>
    <select class="default-input" data-images-picker-target="picker" data-action="change->images-picker#add">
        <option value="">{{ 'blogpost.form.placeholder'|trans }}</option>
        {% for image in form.images.vars.recentImages %}
            <option value="{{ image.id }}" data-url="{{ image.url }}">{{ image.url }}</option>
        {% endfor %}
    </select>

    <div data-images-picker-target="list">
        {% for imageRow in form.images %}
            {{ _self.image_row(imageRow) }}
        {% endfor %}
    </div>
</div>
{% do form.images.setRendered %}
