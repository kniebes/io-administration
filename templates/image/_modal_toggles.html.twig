<a href="#" class="{% if image.categories|length == 0 %}empty {% endif %}modal-toggle default-input" data-modal="category-settings" data-action="click->modal#open">
    <h3>{{ 'image.form.modal_toggle.data'|trans }}</h3>
    {% for category in image.categories %}
        {{ category.term }}
    {% endfor %}
</a>

<a href="#" class="{% if image.tags|length == 0 %}empty {% endif %}modal-toggle default-input" data-modal="tags-settings" data-action="click->modal#open">
    <h3>{{ 'image.form.modal_toggle.tags'|trans }}</h3>
    {% for tag in image.tags %}
        {{ tag.term }}
    {% endfor %}
</a>

<a href="#" class="{% if image.exif|length == 0 %}empty {% endif %}modal-toggle default-input" data-modal="exif-settings" data-action="click->modal#open">
    <h3>{{ 'image.form.modal_toggle.exif'|trans }}</h3>
    <span>
    {% for exif in image.exif %}{{ exif.label.name }}{% if not loop.last %}, {% endif %}{% endfor %}
    </span>
</a>


<a href="#" class="{% if image.translations|length == 0 %}empty {% endif %}modal-toggle default-input" data-modal="translation-settings" data-action="click->modal#open">
    <h3>{{ 'image.form.modal_toggle.translations'|trans }}</h3>
    {% for translation in image.translations %}<span>{{ ('language.' ~ translation.language.value)|trans }}</span>{% endfor %}
</a>

<a href="#" class="{% if image.customFields|length == 0 %}empty {% endif %}modal-toggle default-input" data-modal="custom-fields-settings" data-action="click->modal#open">
    <h3>{{ 'image.form.modal_toggle.custom_fields'|trans }}</h3>
    {% for key, value in image.customFields %}<span>{{ key }}</span>{% endfor %}
</a>
