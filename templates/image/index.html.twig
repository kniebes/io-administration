{% extends 'base.html.twig' %}

{% block title %}{{ 'image.index.title'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/common/pagination.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/pages/image-index.css') }}">
{% endblock %}

{% block breadcrumb_elements %}
    <li><span>{{ 'breadcrumb.image_index'|trans }}</span></li>
{% endblock %}


{% block body %}
    <main class="image-container">

        <div class="upload-area"
             data-controller="image-upload"
             data-image-upload-url-value="{{ path('image_upload') }}"
             data-image-upload-csrf-token-value="{{ csrf_token('image-upload') }}"
             data-image-upload-uploading-label-value="{{ 'image.index.upload.uploading'|trans }}"
             data-image-upload-edit-label-value="{{ 'image.index.upload.edit'|trans }}"
             data-image-upload-error-label-value="{{ 'image.index.upload.error.network'|trans }}"
             data-image-upload-frame-id-value="image-list"
        >
            <div class="upload"
                 data-image-upload-target="area"
                 data-action="click->image-upload#open dragover->image-upload#dragOver dragleave->image-upload#dragLeave drop->image-upload#drop"
            >{{ 'image.index.upload.label'|trans }}</div>
            <input type="file"
                   multiple
                   accept="image/jpeg,image/png,image/webp"
                   hidden
                   data-image-upload-target="input"
                   data-action="change->image-upload#select"
            >
            <ul class="upload-status" data-image-upload-target="list"></ul>
            <template data-image-upload-target="editIcon">{{ ux_icon('lucide:pencil', {'aria-hidden': 'true'}) }}</template>
        </div>

        <turbo-frame id="image-list">

            {{ form_start(filterForm, {
                action: path('image_index'),
                attr: {
                    class: 'filter',
                    'data-turbo-action': 'advance'
                }
            }) }}
            <fieldset>
                <legend>{{ 'image.index.filter.legend'|trans }}</legend>
                <div class="filter-form-elements">
                    {{ form_row(filterForm.searchQuery) }}
                </div>
                <div class="filter-action">
                    <button type="submit">{{ 'blogpost.index.filter.submit'|trans }}</button>
                    {{ form_widget(filterForm.reset) }}
                </div>
            </fieldset>
            {{ form_end(filterForm) }}

            <div class="count">
                {{ 'image.index.count'|trans({'%count%': pagination.getTotalItemCount}) }}
            </div>

            <div class="page-navigation">
                {{ knp_pagination_render(pagination) }}
            </div>

            <div class="image-table">
                {% for image in pagination %}
                    <div class="image-item">
                        <a class="image-link" data-turbo-frame="_top" href="{{ path('image_edit', { id: image.id }) }}">
                            <img src="{{ getImagePreviewUrl(image) }}" alt="{{ image.altText }}"/>
                        </a>
                        <div class="image-info">
                            <span class="image-title">{{ image.title }}</span>
                            <form method="post"
                                  data-turbo-frame="_top"
                                  action="{{ path('image_delete', {id: image.id}) }}"
                                  data-turbo-confirm="{{ 'image.index.delete.confirm'|trans({'%count%': image.blogPosts|length}) }}">
                                <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                                       value="{{ csrf_token('delete-image-' ~ image.id) }}">
                                <button type="submit"
                                        class="delete"
                                        title="{{ 'image.index.action.delete'|trans }}"
                                        aria-label="{{ 'image.index.action.delete'|trans }}">
                                    {{ ux_icon('lucide:trash-2', {'aria-hidden': 'true'}) }}
                                </button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="page-navigation">
                {{ knp_pagination_render(pagination) }}
            </div>

        </turbo-frame>

    </main>
{% endblock %}
