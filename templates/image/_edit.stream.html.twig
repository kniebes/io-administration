<turbo-stream action="update" target="image-save-info">
    <template>
        {% include 'blog_post/_save_info.html.twig' %}
    </template>
</turbo-stream>

<turbo-stream action="update" target="image-modal-toggles">
    <template>
        {% include 'image/_modal_toggles.html.twig' with {image: image} %}
    </template>
</turbo-stream>

<turbo-stream action="update" target="image-tags-picker">
    <template>
        {% include 'blog_post/_tags_picker.html.twig' with {form: form} %}
    </template>
</turbo-stream>

<turbo-stream action="update" target="image-custom-fields">
    <template>
        {% include 'blog_post/_custom_fields.html.twig' with {form: form} %}
    </template>
</turbo-stream>
