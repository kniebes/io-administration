{% extends 'base.html.twig' %}

{% block title %}Übersicht{% endblock %}

{% block body %}
    <main class="dashboard">
        <h1>Übersicht</h1>

        <p>Angemeldet als <strong>{{ currentUser.userIdentifier }}</strong>.</p>

        {# Logout muss POST sein: der LogoutListener liest den CSRF-Token nur aus dem Request-Body. #}
        <form method="post" action="{{ logout_path('main') }}">
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
            <button type="submit">Abmelden</button>
        </form>
    </main>
{% endblock %}
