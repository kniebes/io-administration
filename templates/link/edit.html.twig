{% extends 'base.html.twig' %}

{% block title %}{{ link.title ?: link.url }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/common/modal.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/pages/edit-form.css') }}">
{% endblock %}

{% block breadcrumb_elements %}
    <li><a href="{{ path('link_index') }}">{{ 'breadcrumb.link_index'|trans }}</a></li>
    <li><span>{{ link.title ?: link.url }}</span></li>
{% endblock %}

{% block body %}
    <main class="container" data-controller="modal">

        {{ form_start(form) }}
        <div class="wrapper">
            <div class="editor">
                <p>{{ form_row(form.title) }}</p>
                <p>{{ form_row(form.url) }}</p>
                <p>{{ form_row(form.description) }}</p>
                <p>{{ form_row(form.quote) }}</p>
            </div>

            <div class="sidebar">
                <p>
                    <button type="submit" data-turbo-submits-with="{{ 'link.form.submit_in_progress'|trans }}">{{ 'button.submit'|trans }}</button>
                </p>
                <div id="link-modal-toggles">
                    {% include 'link/_modal_toggles.html.twig' with {link: link} %}
                </div>

                <div id="link-save-info">
                    {% include 'blog_post/_save_info.html.twig' with {
                        success: link.updated is not null,
                        savedAt: link.updated,
                    } %}
                </div>
            </div>
        </div>

        <aside class="backdrop" id="alternate-url-settings">
            <div class="modal default-width">
                <header>{{ 'link.form.modal.header.alternate_url'|trans }}</header>
                <fieldset>
                    <p>{{ form_row(form.alternateUrl) }}</p>
                </fieldset>
                <footer>
                    <button class="close" type="button" data-action="click->modal#close">{{ 'button.close'|trans }}</button>
                    <button type="submit" data-action="click->modal#closeOnSubmit">{{ 'button.submit'|trans }}</button>
                </footer>
            </div>
        </aside>

        <aside class="backdrop" id="custom-fields-settings">
            <div class="modal default-width">
                <header>{{ 'link.form.modal.header.custom_fields'|trans }}</header>
                <div id="link-custom-fields">
                    {% include 'blog_post/_custom_fields.html.twig' with {form: form} %}
                </div>
                <footer>
                    <button class="close" type="button" data-action="click->modal#close">{{ 'button.close'|trans }}</button>
                    <button type="submit" data-action="click->modal#closeOnSubmit">{{ 'button.submit'|trans }}</button>
                </footer>
            </div>
        </aside>
        {{ form_end(form) }}
    </main>
{% endblock %}
